# Secrets and settings for the demo.  deploy.sh creates .env from this file
# on its first run, filling every empty value with a random one.  .env is not
# committed; keep it that way.  Change a secret only after ./clean.sh (the
# database and Zuul's keystore keep the old one).

# The address the published ports bind to.  Leave it on 127.0.0.1: the demo's
# stream is open (insecure = true), so anyone who can reach it can drive it.
DEMO_BIND=127.0.0.1

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
ZUUL_KEYSTORE_PASSWORD=
# Zuul's api_token (git-stream's [api_tokens] zuul) and webhook_token.
ZUUL_API_TOKEN=
WEBHOOK_TOKEN=
