# Template for zuul.conf: deploy.sh fills in the @NAME@ values from .env
# and writes zuul.conf, which is not committed.  Edit this file.

[zookeeper]
hosts=zk:2281
tls_cert=/var/certs/certs/client.pem
tls_key=/var/certs/keys/clientkey.pem
tls_ca=/var/certs/certs/cacert.pem

[keystore]
password=@ZUUL_KEYSTORE_PASSWORD@

[scheduler]
tenant_config=/etc/zuul/main.yaml

[database]
dburi=mariadb+pymysql://zuul:@MYSQL_PASSWORD@@mysql/zuul

[merger]
git_user_email=zuul@example.com
git_user_name=Zuul

[executor]
variables=/etc/zuul/site-variables.yaml
# zuul-web streams live job output from the executor by this name.
hostname=executor
private_key_file=/var/lib/zuul/ssh/id_rsa
default_username=zuul
trusted_rw_paths=/srv/static/logs
# The demo VM is small; don't let the load governors stop the executor
# from accepting jobs.
load_multiplier=100
min_avail_mem=0
min_avail_hdd=0
min_avail_inodes=0

[web]
listen_address=0.0.0.0
port=9000
root=http://localhost:9000

# git-stream speaks GitLab, so this is Zuul's stock GitLab driver: it
# reads merge requests and branches from git-stream's REST API, clones
# over HTTP, reports with comments and approvals, and gets git-stream's
# webhooks on http://web:9000/api/connection/gitlab/payload.
[connection gitlab]
driver=gitlab
server=git-stream
baseurl=http://git-stream:8090
api_token=@ZUUL_API_TOKEN@
webhook_token=@WEBHOOK_TOKEN@

# Zuul's own config (pipelines, jobs) lives in a plain git repository, as it
# would in production; the gitserver container serves ./repos/zuul-config.
# Zuul checks it for new commits every poll_delay seconds.
[connection config-git]
driver=git
baseurl=http://gitserver:8091
poll_delay=10
